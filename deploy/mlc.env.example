# Settings for the course app. Copy to /etc/mlc/mlc.env, fill in, and make it readable by the service only:
#   sudo install -m 600 -o mlc deploy/mlc.env.example /etc/mlc/mlc.env

MLC_AUTH_MODE=oidc
# University sign-in: the Microsoft Entra ID app registered for this site
MLC_AZURE_CLIENT_ID=<application (client) id>
MLC_AZURE_CLIENT_SECRET=<client secret>
MLC_AZURE_TENANT_ID=<directory (tenant) id>
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
MLC_SECRET_KEY=<long random string>
MLC_REVIEWERS=["cz201"]
# At release, hide pages that have not been reviewed (reviewers still see them):
MLC_SHOW_UNREVIEWED=true
# REQUIRED behind nginx with TLS: without it Django's CSRF check rejects sign-out and reviewer-mode posts
MLC_TRUST_PROXY=1
# SQLite database (allowlist, admin accounts); the folder must be writable by the service.
# In Docker, a bind-mounted var/ must be chowned to the container's mlc uid (`docker run --rm --entrypoint id mlc -u mlc`);
# a named volume needs nothing.
MLC_DB_PATH=/srv/mlc/var/db.sqlite3

# Reading assistant: the Ollama cloud service (or a local Ollama server)
MLC_ASSISTANT_ENABLED=true
MLC_OLLAMA_HOST=https://ollama.com
MLC_OLLAMA_API_KEY=<API key from the Language Centre's Ollama account>
MLC_ASSISTANT_MODEL=gemma4:31b   # chosen in the evaluation (docs/assistant-evaluation.md); on the free plan
