# nginx site for the course app. Replace course.example.cam.ac.uk and the certificate paths.
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/mlc
#   sudo ln -s /etc/nginx/sites-available/mlc /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name course.example.cam.ac.uk;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name course.example.cam.ac.uk;

    ssl_certificate     /etc/ssl/certs/course.example.cam.ac.uk.pem;
    ssl_certificate_key /etc/ssl/private/course.example.cam.ac.uk.key;

    # Compress pages: the glossary page is about 1 MB before compression.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_vary on;

    # Static files (CSS, JavaScript, the font) straight from disk, cached by browsers.
    location /static/ {
        alias /srv/mlc/app/static/;
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 30s;
    }

    # The assistant's AI steps can take up to ASSISTANT_STEP_DEADLINE (90 s) plus a wait for a free slot.
    location /assistant/api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 130s;
        client_max_body_size 256k;
    }
}
