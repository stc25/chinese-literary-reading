# Local settings for the course app (development). Copy to app/.env and fill in:
#   cp app/.env.example app/.env
# app/.env is ignored by git: never commit it. Real environment variables win over this file.
# On the server, use deploy/mlc.env.example instead.

# --- Reading assistant: Ollama cloud model ---------------------------------------------
# API key from your Ollama account (https://ollama.com/settings/keys). Kept on the server,
# never sent to the browser.
Ollama_API=<your Ollama API key>
MLC_OLLAMA_HOST=https://ollama.com
# The model chosen in the evaluation (docs/assistant-evaluation.md).
MLC_ASSISTANT_MODEL=gemma4:31b

# To use a local Ollama server instead, comment out the three lines above and use:
#   MLC_OLLAMA_HOST=http://localhost:11434
#   MLC_ASSISTANT_MODEL=qwen3.5:9b

# --- Optional ---------------------------------------------------------------------------
# MLC_ASSISTANT_ENABLED=false          # switch the assistant off
# MLC_ASSISTANT_DAILY_LIMIT=40         # AI calls per user per day
# MLC_DEV_USER=cz201                   # act as this user (with MLC_REVIEWERS, to try reviewer mode)
# MLC_REVIEWERS=["cz201"]
# MLC_DEBUG=1                         # development server settings: no sign-in, content reloads
# MLC_DB_PATH=var/db.sqlite3           # SQLite file (default: var/db.sqlite3 in the repository)
